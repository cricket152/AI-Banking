# 本地开发：复制为 .env，服务只监听 127.0.0.1，切勿用于公网部署。
BANK_ORIGIN=http://127.0.0.1:8000
BANK_LOCAL_HTTP=true
BANK_DATABASE=.local/banking.sqlite3

# offline 为明确标注的本地规则演示；model 才会请求模型供应商。
AGENT_MODE=offline

# 可选的模型配置。密钥仅放本地 .env，不要提交或在浏览器输入。
# MODEL_NAME 按供应商支持的工具调用模型填写，不预设比赛模型。
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API=responses
MODEL_NAME=
MODEL_API_KEY=
# 兼容 Chat Completions 的供应商可改 MODEL_API=chat；需支持 function calling。

# 终端轨迹默认开启；仅用于合成测试数据。关闭内容后只输出阶段和耗时。
AGENT_TRACE_ENABLED=true
AGENT_TRACE_CONTENT=true
# 供应商可见思考 / 摘要会输出，加密或未返回的内部思考不会被解密或推测。
# 可按实际模型调整输出预算；本地允许 256–16384，供应商还可能有自己的限制。
MODEL_MAX_OUTPUT_TOKENS=1500
